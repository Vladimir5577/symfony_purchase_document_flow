# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
# Окружение Symfony: dev | prod
APP_ENV=prod
# Генерация: openssl rand -hex 16
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
###< symfony/framework-bundle ###

# Порт nginx закупок на хосте (docker-compose.yml)
PURCHASE_NGINX_PORT=8096

###> doctrine/doctrine-bundle ###
# База закупок (контейнер postgres_purchase). Эти же DB_* читает docker-compose.yml.
DB_DATABASE=purchase
DB_USERNAME=purchase
DB_PASSWORD=change-me
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@postgres_purchase:5432/${DB_DATABASE}?serverVersion=16.4&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# JWT выдаёт монолит. Здесь только проверка подписи его публичным ключом:
# docker-compose.yml монтирует ../symfony_documents_flow/config/jwt/public.pem сюда.
JWT_PUBLIC_KEY=/config/jwt/public.pem
###< lexik/jwt-authentication-bundle ###

###> symfony/messenger ###
# RabbitMQ монолита: уведомления уходят в exchange events. Значение — как RABBITMQ_TRANSPORT_DSN у монолита.
RABBITMQ_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f
###< symfony/messenger ###

# MinIO монолита, бакет закупок. Ключи — как у монолита.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PURCHASE_BUCKET=purchase

# Превью картинок через imgproxy монолита
IMGPROXY_CACHE_BASE_URL=/media/preview

# OnlyOffice монолита: адрес, по которому его открывает браузер. Секрет — как ONLYOFFICE_JWT_SECRET у монолита (пусто, если подпись выключена).
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8086
ONLYOFFICE_JWT_SECRET=

# Справочник пользователей и организаций (go_directory_document_flow). Токен — DIRECTORY_SERVICE_TOKEN из его .env.
DIRECTORY_URL=http://directory_service:8093
DIRECTORY_SERVICE_TOKEN=
